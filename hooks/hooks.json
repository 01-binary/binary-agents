{
  "description": "binary-agents: 편집한 파일 포맷(PostToolUse), 세션 종료 전 typecheck+test 게이트(Stop)",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/format-edited-file.sh"],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/stop-verify.sh"],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
